---
import { Image } from 'astro:assets';
import screenshot from '../../assets/screenshots/dashboard.webp';
---

<section class="ed-section">
  <div class="ed-container ed-align-right">
    <div class="ed-accent-rule ed-accent-rule-right" aria-hidden="true"></div>
    <h2 class="ed-section-label">Monitor your agents</h2>
    <p class="ed-section-desc">
      A tmux popup dashboard to track progress across all agents.
    </p>
  </div>
  <div class="ed-container ed-showcase">
    <div class="ed-window-glow" aria-hidden="true"></div>
    <div class="terminal-window">
      <div class="terminal-header" aria-hidden="true">
        <div class="window-controls">
          <span class="control red"></span><span class="control yellow"
          ></span><span class="control green"></span>
        </div>
        <div class="window-title">workmux dashboard</div>
      </div>
      <Image
        src={screenshot}
        alt="workmux dashboard tracking multiple AI agents"
        layout="constrained"
        widths={[375, 640, 900, 1280, 1800]}
        sizes="(max-width: 60rem) calc(100vw - 2.5rem), 56rem"
      />
    </div>
  </div>
</section>

<style>
  img {
    display: block;
    width: 100%;
  }
</style>
