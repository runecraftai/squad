---
const testimonials = [
  {
    quote:
      '"I\'ve been using (and loving) workmux which brings together tmux, git worktrees, and CLI agents into an opinionated workflow."',
    author: '@Coolin96',
    source: 'Hacker News',
    href: 'https://news.ycombinator.com/item?id=46029809',
  },
  {
    quote:
      '"Thank you so much for your work with workmux! It\'s a tool I\'ve been wanting to exist for a long time."',
    author: '@rstacruz',
    source: 'GitHub',
    href: 'https://github.com/raine/workmux/issues/2',
  },
  {
    quote:
      '"It\'s become my daily driver - the perfect level of abstraction over tmux + git, without getting in the way or obscuring the underlying tooling."',
    author: '@cisaacstern',
    source: 'GitHub',
    href: 'https://github.com/raine/workmux/issues/33',
  },
  {
    quote:
      '"I have to mention workmux at every opportunity because it\'s the perfect glue between worktrees, agents and tmux windows."',
    author: '@dedbrizz',
    source: 'Threads',
    href: 'https://www.threads.com/@dedbrizz/post/DVt1DtLkr_l',
  },
  {
    quote:
      '"Since I discovered workmux I\'m cooking. Amazing parallel-agent driver if you like tmux and want to keep your config."',
    author: '@MatijaSosic',
    source: 'X',
    href: 'https://x.com/MatijaSosic/status/2080022087281127659',
  },
  {
    quote:
      '"Using workmux with a well-configured tmux has been a breath of fresh air"',
    author: '@sbeirakh_il',
    source: 'X',
    href: 'https://x.com/sbeirakh_il/status/2080279929778733305',
  },
  {
    quote:
      '"I\'ve been using it for about a month now, and it\'s been nothing but great."',
    author: '@gabrielrockson_',
    source: 'X',
    href: 'https://x.com/gabrielrockson_/status/2080386326566736189',
  },
];
---

<section class="ed-section">
  <div class="ed-container">
    <div class="ed-accent-rule" aria-hidden="true"></div>
    <h2 class="ed-section-label">What people are saying</h2>
    <div class="list">
      {
        testimonials.map(({ quote, author, source, href }) => (
          <figure>
            <blockquote>{quote}</blockquote>
            <figcaption>
              - {author} <a href={href}>via {source}</a>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .list {
    display: grid;
    gap: 4rem;
  }

  figure {
    max-width: 47rem;
    margin: 0;
  }

  blockquote {
    padding: 0;
    margin: 0 0 0.75rem;
    border: 0;
    color: var(--ed-text-1);
    font-size: 1.375rem;
    font-style: italic;
    line-height: 1.5;
  }

  figcaption {
    margin: 0;
    color: var(--ed-text-2);
    font-family: var(--ed-font-mono);
    font-size: 0.8125rem;
    line-height: 1.5rem;
  }

  a {
    color: var(--ed-accent-text);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  a:hover,
  a:focus-visible {
    text-decoration: underline;
  }

  @media (max-width: 40rem) {
    blockquote {
      font-size: 1.125rem;
    }
  }
</style>
