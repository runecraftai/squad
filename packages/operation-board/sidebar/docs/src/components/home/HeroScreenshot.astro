---
import { Image } from 'astro:assets';
import screenshot from '../../assets/screenshots/hero-screenshot.webp';
---

<section class="hero-screenshot" aria-label="workmux terminal preview">
  <div class="ed-container ed-showcase">
    <div class="ed-window-glow" aria-hidden="true"></div>
    <div class="terminal-window">
      <div class="terminal-header" aria-hidden="true">
        <div class="window-controls">
          <span class="control red"></span><span class="control yellow"
          ></span><span class="control green"></span>
        </div>
        <div class="window-title">Terminal</div>
      </div>
      <Image
        src={screenshot}
        alt="workmux in action with multiple AI agents working across tmux windows"
        loading="eager"
        fetchpriority="high"
        layout="constrained"
        widths={[375, 640, 900, 1280, 1800]}
        sizes="(max-width: 60rem) calc(100vw - 2.5rem), 56rem"
      />
    </div>
  </div>
</section>

<style>
  .hero-screenshot {
    padding-bottom: 6rem;
    margin-top: -5rem !important;
  }

  img {
    display: block;
    width: 100%;
  }
</style>
