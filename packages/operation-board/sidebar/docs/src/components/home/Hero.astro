---
import { getGitHubStars } from './stars';

const stars = await getGitHubStars();
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-glow"></div>
    <div class="hero-grid"></div>
  </div>
  <div class="ed-container hero-inner">
    <div class="hero-text">
      <span class="hero-name">workmux</span>
      <h1 id="_top">Terminal-first workflow for parallel AI agents.</h1>
      <p class="tagline">
        Turn your terminal into a multi-agent workspace. Every task gets a
        dedicated{' '}<span class="term">git worktree</span>{' '}and{' '}<span
          class="term">tmux window</span
        >, letting agents code conflict-free.
      </p>
      <div class="actions">
        <a href="/guide/quick-start/" class="ed-btn-primary">Get started</a>
        <a href="https://github.com/raine/workmux" class="github-button">
          GitHub
          {
            stars && (
              <span class="star-count" aria-label={`${stars} GitHub stars`}>
                ★ {stars}
              </span>
            )
          }
        </a>
      </div>
    </div>
    <div class="hero-logo" aria-hidden="true">
      <img src="/icon.svg" alt="" class="logo-light" />
      <img src="/icon-dark.svg" alt="" class="logo-dark" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 8rem 0 7rem;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-glow {
    position: absolute;
    top: -20%;
    left: 50%;
    width: 50rem;
    height: 37.5rem;
    transform: translateX(-50%);
    background: radial-gradient(
      ellipse at center,
      var(--ed-accent) 0%,
      transparent 70%
    );
    filter: blur(3.75rem);
    opacity: 0.08;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--sl-color-hairline) 1px, transparent 1px),
      linear-gradient(90deg, var(--sl-color-hairline) 1px, transparent 1px);
    background-size: 3.75rem 3.75rem;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, black, transparent);
    opacity: 0.45;
  }

  .hero-inner {
    position: relative;
    display: flex;
    gap: 4rem;
    align-items: center;
    justify-content: space-between;
  }

  .hero-text {
    flex: 1;
    min-width: 0;
  }

  .hero-name {
    display: block;
    margin-bottom: 1.25rem;
    color: var(--ed-accent-text);
    font-family: var(--ed-font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  h1 {
    max-width: none;
    margin: 0 0 2rem;
    color: var(--ed-text-1);
    font-family: var(--ed-font-display);
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.25;
  }

  .tagline {
    max-width: 27.5rem;
    margin: 0 0 2.5rem;
    color: var(--ed-text-2);
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    font-size: 1rem;
    line-height: 1.75;
  }

  .term {
    color: var(--ed-accent-text);
    border-bottom: 1px solid var(--ed-accent);
  }

  .actions {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .github-button {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    color: var(--ed-text-2);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }

  .github-button:hover,
  .github-button:focus-visible {
    color: var(--ed-text-1);
  }

  .star-count {
    min-width: 3rem;
    padding-left: 0.5rem;
    border-left: 1px solid var(--sl-color-hairline-light);
    opacity: 0.8;
  }

  .hero-logo {
    width: 12.5rem;
    flex: 0 0 auto;
  }

  .hero-logo img {
    width: 100%;
    height: auto;
  }

  .logo-dark {
    display: none;
  }

  :global(:root[data-theme='dark']) .logo-light {
    display: none;
  }

  :global(:root[data-theme='dark']) .logo-dark {
    display: block;
  }

  @media (max-width: 60rem) {
    .hero {
      padding: 5rem 0;
    }

    .hero-inner {
      gap: 2rem;
    }

    .hero-logo {
      width: 8.75rem;
    }
  }

  @media (max-width: 40rem) {
    .hero {
      padding: 3.5rem 0;
    }

    h1 {
      font-size: 1.75rem;
      line-height: 2.5rem;
    }

    .hero-logo {
      display: none;
    }

    .actions {
      gap: 1rem;
    }
  }
</style>
